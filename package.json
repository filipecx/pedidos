{
  "name": "temp_next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "worker": "tsx --env-file=.env.local src/server/workers/all.worker.ts",
    "worker:email": "tsx --env-file=.env.local src/server/workers/email.worker.ts",
    "worker:images": "tsx --env-file=.env.local src/server/workers/image.worker.ts",
    "queues:board": "tsx --env-file=.env.local src/server/workers/dashboard.ts",
    "build:next": "next build",
    "build:workers": "esbuild src/server/workers/all.worker.ts --bundle --platform=node --target=node20 --outdir=dist/server --packages=external",
    "build:dashboard": "esbuild src/server/workers/dashboard.ts --bundle --platform=node --target=node20 --outdir=dist/server --packages=external",
    "build:migrate": "esbuild src/db/migrate.ts --bundle --platform=node --target=node20 --outdir=dist/db --packages=external",
    "build": "npm run build:next && npm run build:workers && npm run build:dashboard && npm run build:migrate",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "@bull-board/ui": "^9.10.4",
    "@heroicons/react": "^2.2.0",
    "better-auth": "^1.7.7",
    "bullmq": "^6.3.11",
    "drizzle-orm": "^0.45.3",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "next": "16.3.7",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^5.0.2",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  }
}
