# Database (PostgreSQL via Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pedidos"

# Cache & Queues (Redis via Docker)
REDIS_URL="redis://localhost:6379"

# Node Environment
NODE_ENV="development"

# Cloudflare image upload
R2_PUBLIC_URL="https://pub-your-bucket.r2.dev"
R2_URL="https://your-account-id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your_access_key_id"
R2_SECRET_ACCESS_KEY="your_secret_access_key"

# BetterAuth
BETTER_AUTH_SECRET="gerar-secret-aleatorio-aqui"
BETTER_AUTH_URL="http://localhost:3000"

# OpenPix
OPENPIX_APP_ID="sua_api_key_ou_app_id_aqui"
OPENPIX_WEBHOOK_SECRET="seu_webhook_secret_aqui"

# Ngrok (para túnel de desenvolvimento / webhooks locais)
NGROK_AUTHTOKEN="seu_token_ngrok_aqui"
